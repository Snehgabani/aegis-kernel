{
  "name": "@aegis-kernel/gateway",
  "version": "1.0.1",
  "description": "Aegis Cloud Gateway: Serverless Telemetry, Stripe Billing Webhooks, and Audit Store",
  "license": "MIT",
  "author": "Sneh Gabani <sneh@aegis-kernel.dev>",
  "homepage": "https://snehgabani.github.io/aegis-kernel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snehgabani/aegis-kernel.git",
    "directory": "services/gateway"
  },
  "bugs": {
    "url": "https://github.com/Snehgabani/aegis-kernel/issues"
  },
  "keywords": [
    "gateway",
    "telemetry",
    "stripe",
    "audit-store",
    "ai-security"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aegis-kernel/core": "*",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsup": "^8.3.6",
    "vitest": "^4.1.11"
  }
}
