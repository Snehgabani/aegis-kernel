# Aegis Invariant Kernel: Isolated Unbiased 100-Vector Benchmark Container
FROM node:22-alpine

WORKDIR /app

# Upgrade base packages and create non-root user
RUN apk upgrade --no-cache && \
    addgroup -g 10001 -S aegis && \
    adduser -u 10001 -S aegis -G aegis

# Copy repository
COPY --chown=10001:10001 package.json turbo.json tsconfig.json vitest.config.ts ./
COPY --chown=10001:10001 packages ./packages
COPY --chown=10001:10001 services ./services

# Clean install and build without host caching
RUN npm install && npm run build

USER 10001:10001

# Run Vitest test matrix and Tricky 100-Vector benchmark harness
CMD ["npx", "vitest", "run", "packages/evals/__tests__/tricky-100.test.ts"]
