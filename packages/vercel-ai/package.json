{
  "name": "@aegis-kernel/vercel-ai",
  "version": "1.0.0",
  "description": "Aegis Invariant Kernel Middleware & Tool Wrapper for Vercel AI SDK (Core / AI)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "keywords": [
    "aegis",
    "vercel-ai",
    "ai-sdk",
    "agent-safety",
    "guardrails",
    "tool-calling",
    "security"
  ],
  "author": "Sneh Gabani <sneh@aegis-kernel.dev>",
  "license": "MIT",
  "dependencies": {
    "@aegis-kernel/core": "*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
