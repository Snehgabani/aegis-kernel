{
  "name": "@aegis-kernel/cli",
  "version": "1.1.0",
  "type": "module",
  "description": "Developer CLI for Aegis Invariant Kernel: init, test, and report",
  "license": "MIT",
  "author": "Sneh Gabani <sneh@aegis-kernel.dev>",
  "homepage": "https://snehgabani.github.io/aegis-kernel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snehgabani/aegis-kernel.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Snehgabani/aegis-kernel/issues"
  },
  "keywords": [
    "aegis",
    "ai-guardrails",
    "cli",
    "agent-security",
    "tool-clearance"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aegis": "./bin/aegis.js"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "js-yaml": "^5.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@aegis-kernel/core": "*",
    "@aegis-kernel/diagnostics": "*",
    "@aegis-kernel/evals": "*",
    "@aegis-kernel/mcp": "*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
