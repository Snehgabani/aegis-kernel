{
  "name": "@aegis-kernel/anthropic",
  "version": "1.0.0",
  "description": "Anthropic Claude tool_use deterministic invariant safety guard",
  "license": "MIT",
  "author": "Sneh Gabani <sneh@aegis-kernel.dev>",
  "homepage": "https://aegis-kernel.dev",
  "repository": {
    "type": "git",
