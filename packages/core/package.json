{
  "name": "@aegis-kernel/core",
  "version": "1.0.1",
  "type": "module",
  "description": "Core deterministic invariant clearance engine for AI agent tool execution",
  "license": "MIT",
  "author": "Sneh Gabani <sneh@aegis-kernel.dev>",
  "homepage": "https://snehgabani.github.io/aegis-kernel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snehgabani/aegis-kernel.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Snehgabani/aegis-kernel/issues"
  },
  "keywords": [
    "ai-guardrails",
    "ai-safety",
    "agent-firewall",
    "zero-trust-ai",
    "mcp-security",
    "model-context-protocol",
    "tool-call-security",
    "llm-security",
    "prompt-injection-defense",
    "ast-invariants",
    "eu-ai-act",
    "soc2-compliance",
    "langchain",
    "anthropic",
    "openai"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "packs"
  ],
  "scripts": {
    "build": "npm run gen:packs && tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "gen:packs": "node ../../scripts/gen-packs.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "js-yaml": "^5.3.0",
    "node-sql-parser": "^5.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
