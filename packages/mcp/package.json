{
  "name": "@aegis-kernel/mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) JSON-RPC safety clearance middleware for AI agents",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aegis-kernel/core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
