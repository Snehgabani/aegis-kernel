#!/bin/sh
# Aegis Conventional Commits Validator Hook
commit_msg=$(cat "$1")

pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9\-]+\))?: .+"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "❌ Error: Commit message does not follow Conventional Commits specification."
  echo ""
  echo "Expected format:"
  echo "  feat(scope): add new feature"
  echo "  fix(sql): prevent AST bypass"
  echo "  docs(readme): update quickstart"
  echo ""
  echo "Your message was: '$commit_msg'"
  exit 1
fi

exit 0
