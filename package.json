{
  "name": "aegis-kernel-monorepo",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "description": "Aegis Invariant Kernel: Deterministic Tool-Call Safety Gateway for AI Agents",
  "license": "MIT",
  "author": "Sneh Gabani <https://github.com/Snehgabani>",
  "homepage": "https://snehgabani.github.io/aegis-kernel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snehgabani/aegis-kernel.git"
  },
  "bugs": {
    "url": "https://github.com/Snehgabani/aegis-kernel/issues"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build --no-daemon --concurrency=4",
    "test": "vitest run",
    "test:fuzz": "vitest run packages/core/__tests__/tautology-fuzz.test.ts packages/evals/__tests__/adversarial-fuzz.test.ts packages/core/__tests__/adversarial-unicode-fuzz.test.ts",
    "test:security": "bash scripts/security-audit.sh",
    "test:integration": "vitest run packages/core/__tests__/exfiltration-integration.test.ts packages/core/__tests__/deception-and-distributed.test.ts",
    "test:all": "vitest run && bash scripts/security-audit.sh",
    "gen:homoglyphs": "node scripts/gen-homoglyph-maps.mjs",
    "fetch:benchmarks": "node scripts/fetch-canonical-benchmarks.mjs",
    "lint": "turbo run lint --no-daemon --concurrency=4",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "tsup": "^8.3.6",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
